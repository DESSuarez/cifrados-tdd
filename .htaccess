# Hostinger clona el repo completo; solo se sirve app/
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/app/
RewriteRule ^(.*)$ app/$1 [L]
Header set X-Robots-Tag "noindex, nofollow"
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache"
</FilesMatch>
AddType application/manifest+json .webmanifest
